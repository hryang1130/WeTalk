FROM ubuntu:22.04 AS builder
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake g++ protobuf-compiler libprotobuf-dev \
    libmysqlclient-dev libssl-dev libzstd-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src/we_reactor
COPY we_reactor/ ./
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j"$(nproc)" --target re_dns

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libprotobuf23 libmysqlclient21 mysql-client-core-8.0 bash && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/we_reactor/build/bin/re_dns /app/re_dns
COPY docker/route/wait-mysql.sh /app/wait-mysql.sh
WORKDIR /app
# 等 mysql 真实实例可查（TCP）后再启动，避开 init 临时实例窗口（见 wait-mysql.sh）
ENTRYPOINT ["/app/wait-mysql.sh", "wetalk_route", "--"]
CMD ["/app/re_dns"]
