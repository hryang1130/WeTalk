FROM ubuntu:22.04 AS builder
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential make g++ protobuf-compiler libprotobuf-dev \
    libmysqlclient-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src/third_party/Lars
COPY third_party/Lars/ ./
# 生成 lars.pb
RUN protoc --cpp_out=base/proto -Ibase/proto base/proto/lars.proto && \
    make -C lars_reactor && make -C api/cpp/lars_api BASE=../../base && \
    make -C lars_dns && make -C lars_loadbalance_agent && make -C lars_reporter

FROM ubuntu:22.04
ARG DEBIAN_FRONTEND=noninteractive
ARG LARS_SERVICE   # dns | agent | reporter
RUN apt-get update && apt-get install -y --no-install-recommends \
    libprotobuf23 libmysqlclient21 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/third_party/Lars/base/proto/lars.pb.* /app/
RUN if [ "$LARS_SERVICE" = "dns" ]; then \
      COPY --from=builder /src/third_party/Lars/lars_dns/bin/lars_dns /app/service; fi
