{
  "name": "wetalk-client",
  "version": "0.1.0",
  "description": "WeTalk desktop client (Electron + Node.js) for llfcchat+Lars integrated server",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mock": "node mock-server.js",
    "shot": "electron tools/shot.js",
    "test:cross": "node test-img-cross.js",
    "test:offline": "node test-offline.js",
    "test:file": "node test-file.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.wetalk.client",
    "productName": "WeTalk",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "WeTalk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
